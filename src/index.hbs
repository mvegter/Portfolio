<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0d1117" />
    {{#with LinkedIn}}
        <meta name="description" content="{{profile.headline}}" />
        <meta property="og:description" content="{{profile.headline}}" />
    {{/with}}
    {{#with profile}}
        <meta name="author" content="{{firstName}} {{lastName}}" />
        <meta property="og:title" content="{{firstName}} {{lastName}}" />
        <meta property="og:type" content="website" />
        <title>{{firstName}} {{lastName}}</title>
    {{/with}}
    <link rel="canonical" href="https://martijnvegter.com/" />
    <link rel="icon" type="image/x-icon" href="assets/img/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="css/styles.css" rel="stylesheet" />
    <script>
        (function() {
            var t = localStorage.getItem('theme');
            if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
        })();
    </script>
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <a href="#about" class="brand">~/mvegter</a>
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">&#9776;</button>
        <picture>
            <source srcset="assets/img/profile.webp" type="image/webp">
            <source srcset="assets/img/profile.jpg" type="image/jpeg">
            <img class="profile-photo" src="assets/img/profile.jpg" alt="{{profile.firstName}} {{profile.lastName}}">
        </picture>
        <nav id="sideNav">
            <a href="#about">about</a>
            <a href="#experience">experience</a>
            <a href="#education">education</a>
            <a href="#skills">skills</a>
            <a href="#contributions">contributions</a>
            <a href="#repositories">repositories</a>
        </nav>
        <div class="theme-toggle">
            <button id="themeToggle" aria-label="Toggle theme">
                <span class="icon-moon">&#9789;</span>
                <span class="icon-sun">&#9788;</span>
            </button>
        </div>
    </aside>

    <main>
        <!-- About -->
        <section class="section hero" id="about">
            <div class="hero-content">
                <h1>
                    {{#with profile}}
                        {{firstName}} <span class="accent">{{lastName}}</span>
                    {{/with}}
                </h1>
                {{#with LinkedIn}}
                    <p class="tagline">{{profile.headline}}</p>
                    {{#if profile.summary}}
                        <p class="summary">{{{breaklines profile.summary}}}</p>
                    {{/if}}
                {{/with}}
                <div class="social-links">
                    {{#each socialMedia}}
                        <a href="{{link}}" target="_blank" rel="noreferrer noopener" aria-label="{{icon}}">
                            <i class="fab fa-{{icon}}"></i>
                        </a>
                    {{/each}}
                </div>
            </div>
        </section>

        <hr />

        <!-- Experience -->
        {{#with LinkedIn}}
        <section class="section" id="experience">
            <h2 class="section-title">Experience</h2>
            <div class="timeline">
                {{#each positions}}
                <div class="timeline-item fade-in">
                    <div class="timeline-header">
                        <h3>{{title}}</h3>
                        <span class="timeline-date">{{date}}</span>
                    </div>
                    <div class="timeline-company">
                        {{#if url}}
                            <a href="{{url}}" target="_blank" rel="noreferrer noopener">{{companyName}}</a>
                        {{else}}
                            {{companyName}}
                        {{/if}}
                    </div>
                    {{#if description}}
                        <p class="timeline-desc">{{{breaklines description}}}</p>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </section>

        <hr />

        <!-- Education -->
        <section class="section" id="education">
            <h2 class="section-title">Education</h2>
            {{#each educations}}
            <div class="edu-item fade-in">
                <div class="edu-header">
                    <div>
                        <h3>{{title}}</h3>
                        <p class="edu-degree">{{degree}}</p>
                    </div>
                    <span class="timeline-date">{{date1}} &ndash; {{date2}}</span>
                </div>
            </div>
            {{/each}}

            {{#if accomplishments.length}}
            <h2 class="section-title" style="margin-top: 2.5rem;">Certifications</h2>
            {{#each accomplishments}}
            <div class="edu-item fade-in">
                <h3>{{title}}</h3>
            </div>
            {{/each}}
            {{/if}}
        </section>

        <hr />

        <!-- Skills & Languages -->
        <section class="section" id="skills">
            <h2 class="section-title">Skills</h2>
            <div class="skills-grid" style="margin-bottom: 2.5rem;">
                {{#each skills}}
                    <span class="skill-tag fade-in">{{title}}</span>
                {{/each}}
            </div>

            {{#if languages.length}}
            <h2 class="section-title">Languages</h2>
            <div class="lang-grid">
                {{#each languages}}
                <div class="lang-item fade-in">
                    <div class="lang-name">{{name}}</div>
                    <div class="lang-level">{{proficiency}}</div>
                </div>
                {{/each}}
            </div>
            {{/if}}

            {{#if projects.length}}
            <h2 class="section-title" style="margin-top: 2.5rem;">Projects</h2>
            {{#each projects}}
            <div class="edu-item fade-in">
                <div class="edu-header">
                    <h3>{{#if link}}<a href="{{link}}" target="_blank" rel="noreferrer noopener">{{name}}</a>{{else}}{{name}}{{/if}}</h3>
                    <span class="timeline-date">{{date}}</span>
                </div>
                {{#if description}}<p class="text-secondary" style="margin-top: 0.5rem;">{{breaklines description}}</p>{{/if}}
            </div>
            {{/each}}
            {{/if}}
        </section>
        {{/with}}

        <hr />

        {{#with GitHub}}
        <!-- Contributions -->
        <section class="section" id="contributions">
            <h2 class="section-title">Contributions</h2>
            <div class="card-grid">
                {{#each contribs}}
                <div class="repo-card fade-in">
                    <h4><a href="{{html_url}}" target="_blank" rel="noreferrer noopener">{{full_name}}</a></h4>
                    <p class="repo-desc">{{description}}</p>
                    <div class="repo-meta">
                        {{#if language}}
                        <span><span class="lang-dot"></span> {{language}}</span>
                        {{/if}}
                        <span>
                            <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"></path></svg>
                            {{stargazers_count}}
                        </span>
                        <span>
                            <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75v-.878a2.25 2.25 0 111.5 0v.878a2.25 2.25 0 01-2.25 2.25h-1.5v2.128a2.251 2.251 0 11-1.5 0V8.5h-1.5A2.25 2.25 0 013.5 6.25v-.878a2.25 2.25 0 111.5 0zM5 3.25a.75.75 0 10-1.5 0 .75.75 0 001.5 0zm6.75.75a.75.75 0 10-.001-1.501.75.75 0 00.001 1.501zM8 12.75a.75.75 0 10-.001 1.501A.75.75 0 008 12.75z"></path></svg>
                            {{forks_count}}
                        </span>
                    </div>
                </div>
                {{/each}}
            </div>
        </section>

        <hr />

        <!-- Repositories -->
        <section class="section" id="repositories">
            <h2 class="section-title">Repositories</h2>
            <div class="card-grid">
                {{#each repos}}
                <div class="repo-card fade-in">
                    <h4><a href="{{html_url}}" target="_blank" rel="noreferrer noopener">{{full_name}}</a></h4>
                    <p class="repo-desc">{{description}}</p>
                    <div class="repo-meta">
                        {{#if language}}
                        <span><span class="lang-dot"></span> {{language}}</span>
                        {{/if}}
                        <span>
                            <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"></path></svg>
                            {{stargazers_count}}
                        </span>
                        <span>
                            <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75v-.878a2.25 2.25 0 111.5 0v.878a2.25 2.25 0 01-2.25 2.25h-1.5v2.128a2.251 2.251 0 11-1.5 0V8.5h-1.5A2.25 2.25 0 013.5 6.25v-.878a2.25 2.25 0 111.5 0zM5 3.25a.75.75 0 10-1.5 0 .75.75 0 001.5 0zm6.75.75a.75.75 0 10-.001-1.501.75.75 0 00.001 1.501zM8 12.75a.75.75 0 10-.001 1.501A.75.75 0 008 12.75z"></path></svg>
                            {{forks_count}}
                        </span>
                    </div>
                </div>
                {{/each}}
            </div>
        </section>
        {{/with}}

        <footer class="site-footer">
            Generated {{date}}
        </footer>
    </main>

    <script src="assets/js/fontawesome-v5.13.0-all.js"></script>
    <script src="js/scripts.js"></script>
</body>
</html>
